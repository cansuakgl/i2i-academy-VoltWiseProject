GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

EMAIL_PROVIDER=logging
RESEND_API_KEY=
EMAIL_FROM=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

TF_VAR_project_name=wattsmart
TF_VAR_environment=dev
TF_VAR_vpc_cidr=10.42.0.0/16
TF_VAR_api_cidr=0.0.0.0/0

TF_VAR_db_username=postgres
TF_VAR_db_password=

# First apply should stay false so Terraform creates ECR before ECS tries to pull images.
# After pushing images, set this to true and apply again.
TF_VAR_deploy_services=false
TF_VAR_deploy_simulator=true
TF_VAR_upload_frontend=false
TF_VAR_image_tag=latest
TF_VAR_backend_image=
TF_VAR_simulator_image=

TF_VAR_postgres_engine_version=16.3
TF_VAR_rds_instance_class=db.t4g.micro
TF_VAR_rds_allocated_storage_gb=20
TF_VAR_rds_backup_retention_days=1
TF_VAR_rds_deletion_protection=false
TF_VAR_rds_skip_final_snapshot=true

TF_VAR_ec2_instance_type=t3.small
TF_VAR_ec2_volume_gb=30

TF_VAR_backend_cpu=1024
TF_VAR_backend_memory=2048
TF_VAR_backend_desired_count=1
TF_VAR_simulator_cpu=512
TF_VAR_simulator_memory=1024
TF_VAR_ignite_cpu=512
TF_VAR_ignite_memory=1024
TF_VAR_log_retention_days=14
